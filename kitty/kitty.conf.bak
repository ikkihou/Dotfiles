# BEGIN_KITTY_THEME
# Catppuccin-Mocha
include current-theme.conf
# END_KITTY_THEME
#

# cursor                          #dc8a78
cursor_trail                    1

# Window_layout
enabled_layouts                 tall:bias=50;full_size=1;mirrored=false
draw_minimal_borders            yes
inactive_text_alpha             0.8
hide_window_decorations         titlebar-only
window_border_width             0.2
window_margin_width             0.1
window_padding_width            1 1 1
enable_audio_bell               yes
remember_window_size            yes
initial_window_width            170
initial_window_height           50

# Editor
editor                          nvim


background_opacity              0.8
background_blur                 20
background_image_layout         cscaled
# macos_titlebar_color            dark
# active_border_color             none


# Tab bar styles
tab_bar_edge                    top
tab_title_template              "{fmt.fg.#a9b665}{title}"
active_tab_title_template       "{fmt.fg.white}{title}"
tab_bar_style                   slant
# tab_bar_edge                    bottom
tab_bar_margin_width            0.0
tab_bar_margin_height           0.0 0.0
tab_bar_style                   powerline
tab_bar_align                   left
tab_bar_min_tabs                2
tab_switch_strategy             previous
tab_fade                        0.25 0.5 0.75 1
tab_separator                   " ┇"
tab_powerline_style             slanted
tab_activity_symbol             none
tab_title_template              "{f'{title[:30]}…' if title.rindex(title[-1]) + 1 > 30 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}"
active_tab_title_template       none
active_tab_font_style           bold-italic
inactive_tab_font_style         normal

scrollback_lines                4000
copy_on_select                  yes

# others
allow_remote_control            yes
allow_hyperlinks                yes
shell_integration               enabled


# shortcus
map opt+ctrl+h neighboring_window left
map opt+ctrl+l neighboring_window right 
map opt+ctrl+j neighboring_window bottom
map opt+ctrl+k neighboring_window up

font_size                       13.0
text_composition_strategy       platform
# 中文
symbol_map U+4E00-U+9FFF,U+3400-U+4DBF LXGW WenKai

# BEGIN_KITTY_FONTS
font_family      family="LXGW WenKai Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
